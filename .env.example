# Local Postgres from docker compose
DATABASE_URL=postgresql://ibrary:ibrary@localhost:5433/ibrary?schema=public

# Required. Use long random strings outside local development.
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

PORT=3000
APP_URL=http://localhost:3000
# Comma-separated browser origins allowed to call the API
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:5174

# Google sign-in. Web and mobile clients send the Google ID token to POST /api/v1/auth/google
GOOGLE_CLIENT_ID=

# Resend transactional email. Leave blank locally; messages are logged instead of sent.
RESEND_API_KEY=
EMAIL_FROM=iBrary <onboarding@resend.dev>

# Paystack secret is used to initialize charges and verify webhooks.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Banner images. local saves under ./uploads and serves them from APP_URL/uploads.
# Set s3 when AWS is connected. The S3 driver is the swap point; it does not upload yet.
STORAGE_DRIVER=local
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_PUBLIC_URL=

# Podcast scripts and two-voice audio. Leave the key blank locally.
# Without it, the lesson text is turned into a two-host script on the server,
# and this Mac can speak it with the system voices. Nothing is labelled as a model reply.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_TTS_MODEL=tts-1-hd
OPENAI_GUIDE_VOICE=alloy
OPENAI_STUDENT_VOICE=nova
